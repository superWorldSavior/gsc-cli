    "lib/",
    "bin/",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "gsc-auth": "node bin/gsc-auth.js",
    "gsc-query": "node bin/gsc-query.js"
  },
  "dependencies": {}
